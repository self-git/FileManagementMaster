{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileManagementMaster",
  "version": "0.1.0",
  "identifier": "dev.filemanagementmaster.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FileManagementMaster",
        "width": 890,
        "height": 680,
        "minWidth": 420,
        "minHeight": 410
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/git/": "git/"
    },
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
